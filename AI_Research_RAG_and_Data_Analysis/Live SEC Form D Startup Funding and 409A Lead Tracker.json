      "parameters": {
        "jsCode": "const body = $input.first().json;\nconst leads = body.leads || [];\nreturn leads.map((r) => ({ json: {\n  company: r.issuer_name,\n  state: r.state_or_country,\n  amount_sold_usd: r.total_amount_sold_usd,\n  executive_signer: r.primary_executive_name,\n  executive_title: r.primary_executive_title,\n  phone: r.issuer_phone,\n  irc_409a_trigger: r.irc_409a_valuation_trigger,\n  qsbs_1202_status: r.irc_1202_qsbs_eligibility,\n  sec_filing_date: r.filing_date\n}}));\n"
