        60
      ]
    },
    {
      "parameters": {
        "content": "## 3. Qualify Leads & Format Summary\nRoutes accounts with true paid ad pixels (`hasAdPixels = true`) or `>= 3` verified DNS SaaS tools, then formats the Slack summary.",
        "height": 380,
        "width": 500,
        "color": 6
      },
      "id": "stk-sec-3",
      "name": "Step 3: Qualify & Format",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1020,
