{
  "name": "iPhone SMS to Google Sheets row (Fwrd webhook)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "fwrd-sms-sheet",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "8c1d3f60-1a7e-4c55-9b0e-2f4b6d1a9e01",
      "name": "Fwrd webhook",
