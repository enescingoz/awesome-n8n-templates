    {
      "id": "fetch-page",
      "name": "Fetch Submitted Page Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        180,
        -100
      ],
      "parameters": {
        "url": "={{ $json.page_url || \"https://example.com\" }}",
