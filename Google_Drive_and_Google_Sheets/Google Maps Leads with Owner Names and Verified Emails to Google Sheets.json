        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ keyword: $json.keyword, location_codes: $json.location_codes, strictness: $json.strictness }) }}",
        "options": {}
      },
      "id": "c4177d8c-4f58-4824-bad1-9f9eeeb0c4e8",
      "name": "Start search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "LeadMerlin x-api-key"
        }
      }
    },
    {
      "parameters": {
        "amount": 20
      },
      "id": "d3c0a66b-1ddb-4452-b5c0-7af732775e60",
