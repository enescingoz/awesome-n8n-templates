      },
      "id": "b10ee1b1-536d-4d5b-adcc-580c6e7e8615",
      "name": "Send Weekly Ad Digest to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1940,
        240
      ]
    }
