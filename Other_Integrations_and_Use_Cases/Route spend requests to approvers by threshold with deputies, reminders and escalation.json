        "jsCode": "\nconst p = $('Apply policy: threshold, approver, deputy').first().json;\nreturn [{ json: { request_id: p.request_id, type: p.type, amount: p.amount, decision: p.decision, approver: p.approver, deputy: p.deputy, reason: p.reason } }];\n"
