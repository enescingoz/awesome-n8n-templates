        "fromEmail": "={{ $('Configuration').first().json.emailFrom }}",
        "toEmail": "={{ $('Configuration').first().json.emailTo }}",
        "subject": "=EU tenders: {{ $json.count }} new today",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {}
      },
      "id": "e1000000-0000-4000-8000-000000000017",
      "name": "Email tender digest",
