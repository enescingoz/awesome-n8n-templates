            }
          ]
        },
        "options": {}
      },
      "id": "e1000000-0000-4000-8000-000000000012",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "// Turn the comma-separated settings into the Actor's input lists.\nconst c = $('Configuration').first().json;\nconst list = (s) => String(s || '').split(',').map((x) => x.trim()).filter(Boolean);\nreturn [{ json: {\n  keywords: list(c.keywords),\n  buyerCountries: list(c.buyerCountries).map((x) => x.toUpperCase()),\n  cpvCodes: list(c.cpvCodes),\n  publishedWithinDays: Number(c.publishedWithinDays),\n  onlyOpenForBids: true,\n  maxResults: Number(c.maxResults),\n} }];\n"
      },
      "id": "e1000000-0000-4000-8000-000000000013",
      "name": "Build Actor input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/kyb-api-toolkit~ted-europa-scraper/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "e1000000-0000-4000-8000-000000000014",
      "name": "Get tenders from TED Actor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        140
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true,
      "credentials": {
        "httpBearerAuth": {
          "id": "",
          "name": "Apify API token (Bearer Auth)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Keep only notices not sent before, then build one digest message.\nconst seen = $getWorkflowStaticData('global');\nseen.ids = seen.ids || {};\nconst fresh = [];\nfor (const item of $input.all()) {\n  const n = item.json;\n  if (!n.noticeId || seen.ids[n.noticeId]) continue;\n  seen.ids[n.noticeId] = Date.now();\n  fresh.push(n);\n}\n// forget notice IDs older than 60 days so the list stays small\nconst cutoff = Date.now() - 60 * 24 * 3600 * 1000;\nfor (const id of Object.keys(seen.ids)) if (seen.ids[id] < cutoff) delete seen.ids[id];\nif (!fresh.length) return [{ json: { count: 0, text: 'No new tenders.' } }];\nconst money = (n) => (typeof n.estimatedValue === 'number' ? `${n.estimatedValue.toLocaleString('en-US')} ${n.currency || ''}` : 'value not stated');\nconst lines = fresh.map((n) =>\n  `- ${n.title}\\n  Buyer: ${n.buyerName} (${n.country}). Value: ${money(n)}. Deadline: ${n.deadlineDate || 'not stated'}.\\n  ${n.noticeUrl}`);\nreturn [{ json: { count: fresh.length, text: `${fresh.length} new EU tender(s):\\n\\n${lines.join('\\n\\n')}` } }];\n"
      },
      "id": "e1000000-0000-4000-8000-000000000015",
      "name": "Skip sent tenders and build digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        140
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "d1",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e1000000-0000-4000-8000-000000000016",
      "name": "Any new tenders?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        140
      ]
    },
    {
