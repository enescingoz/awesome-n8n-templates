    {
      "parameters": {
        "promptType": "define",
        "text": "=Ringkas dokumen berikut.\n\n{{ $json.teks }}",
        "messages": {
          "messageValues": [
            {
              "message": "Kamu meringkas dokumen kerja dalam Bahasa Indonesia. Tulis maksimal 5 poin singkat (diawali \"- \"), lalu satu baris \"Tindak lanjut:\" berisi hal yang perlu dikerjakan, atau \"Tindak lanjut: -\" kalau tidak ada. Jangan menambah informasi yang tidak ada di dokumen."
            }
          ]
        }
