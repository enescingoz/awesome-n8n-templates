{
  "name": "Monitor Target Accounts for Hiring Velocity, Salary Bands & JD Tech Signals (6 ATS)",
  "nodes": [
    {
      "parameters": {
        "content": "## Setup (2 minutes)\n1. Subscribe to the free Basic plan on RapidAPI (`unified-multi-ats-jobs-salary-hiring-intelligence`).\n2. Create a Generic Header Auth credential named **RapidAPI Key** (`x-rapidapi-key`).\n3. Add target account domains or work emails in **Set Target Accounts**.",
        "height": 200,
        "width": 440,
        "color": 4
      },
      "id": "6e385c94-9ae8-4d29-9268-736c09b523aa",
      "name": "Setup Guide",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -240
      ]
    },
    {
      "parameters": {
        "content": "### Auto-Detected Across 6 ATS\nAshby, Greenhouse, Lever, SmartRecruiters, Workday, and BambooHR.\n- `POST /screen` returns open role count, median USD salary, remote share, and top 135+ JD tech-stack signals in one call.",
        "height": 200,
        "width": 420,
        "color": 6
      },
      "id": "d16da373-35d4-4c37-a584-35833c058c6b",
      "name": "Supported ATS Platforms",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        520,
        -240
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1
            }
          ]
        }
      },
      "id": "292f8065-a5bf-4acb-9387-e9d668dac46f",
      "name": "Weekly Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        60
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c59e97a7-bcb3-4d24-ab30-cf3a1edff3f2",
              "name": "companies",
              "value": "={{ ['ramp.com', 'datadoghq.com', 'stripe.com', 'linear.app'] }}",
              "type": "array"
            }
          ]
        }
      },
      "id": "84089974-b668-45ea-a774-407811472e83",
      "name": "Set Target Accounts",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        60
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://unified-multi-ats-jobs-salary-hiring-intelligence.p.rapidapi.com/screen",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-rapidapi-host",
              "value": "unified-multi-ats-jobs-salary-hiring-intelligence.p.rapidapi.com"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ companies: $json.companies }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "48bc19eb-6dc3-48b2-bc68-42dab14da467",
      "name": "Screen 6-ATS Hiring Signals",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        60
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "RapidAPI Key"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "summaries",
        "options": {}
      },
      "id": "f7fae73d-efc2-4ccc-ae0f-7e244d502585",
      "name": "Split Out Company Summaries",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        720,
        60
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c9819fb2-a5a3-4e4c-bf61-765ccd4e7f54",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ok",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "ebd0b2cc-918c-4bf5-9f64-4f86e582d1d0",
              "leftValue": "={{ $json.totalOpenJobs }}",
              "rightValue": 5,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "b4dfd452-56e2-4a81-a27d-587a5e36933d",
      "name": "Filter Active Hiring Accounts",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        60
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a97faed8-fb58-427b-b9fe-291064b2746b",
              "name": "company",
              "value": "={{ $json.company }}",
              "type": "string"
            },
            {
              "id": "08add1d7-8038-4731-9d31-4773b359a52d",
              "name": "ats",
              "value": "={{ $json.ats }}",
              "type": "string"
            },
            {
              "id": "15d695f8-580d-4b20-8d7c-b23136cdf006",
              "name": "openJobs",
              "value": "={{ $json.totalOpenJobs }}",
              "type": "number"
            },
            {
              "id": "2f92e0b0-b221-470f-9d4f-eb5291e63778",
              "name": "medianSalaryUsd",
              "value": "={{ $json.medianSalaryUsd || 0 }}",
              "type": "number"
            },
            {
              "id": "b9befc1e-8bcf-4a82-a2df-f593e66c0cc2",
              "name": "topTechNames",
              "value": "={{ $json.topTechNames || '' }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "714c9f96-d745-4c9e-b776-72ecc7999048",
      "name": "Format Hiring Signal Digest",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1220,
        0
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#hiring-signals"
        },
        "text": "={{ $json.company + ' (' + $json.ats + '): ' + $json.openJobs + ' open roles | Median USD: $' + $json.medianSalaryUsd + ' | Top Tech: ' + $json.topTechNames }}"
      },
      "id": "e3910196-5e7a-4ba3-a6b8-c2010da43b41",
      "name": "Send Hiring Signal Alert to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1460,
        0
      ]
    }
  ],
  "connections": {
