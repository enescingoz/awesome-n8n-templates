{
  "name": "Google Play Low-Star Review Alerts to Slack",
  "nodes": [
    {
      "parameters": {
        "content": "## Google Play low-star review alerts\nEvery morning this pulls yesterday's 1 and 2 star Google Play reviews for your apps (and competitors' apps) and posts a digest to Slack, so support and product see complaints the same day.\n\n**Setup**\n1. In **Config**, set `appIds` (comma-separated package names, e.g. `com.spotify.music`), `country`, `language` and `maxScore`.\n2. In **Get new reviews**, create a *Header Auth* credential: name `Authorization`, value `Bearer YOUR_APIFY_TOKEN` (free Apify account).\n3. Pick your Slack credential and channel in **Post to Slack**.\n\nReviews come from the Google Play Reviews Actor on Apify (pay per result).",
        "height": 380,
        "width": 420
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000001",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -220,
        -200
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000002",
      "name": "Every morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "appIds",
              "value": "com.spotify.music, com.duolingo",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "country",
              "value": "us",
              "type": "string"
            },
            {
              "id": "c3",
              "name": "language",
              "value": "en",
              "type": "string"
            },
            {
              "id": "c4",
              "name": "maxScore",
              "value": 2,
              "type": "number"
            },
            {
              "id": "c5",
              "name": "maxReviews",
              "value": 200,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000003",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/dheerajitbhu~google-play-reviews/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ mode: 'reviews', apps: $json.appIds.split(',').map(s => s.trim()).filter(Boolean), country: $json.country, language: $json.language, sort: 'newest', maxReviews: $json.maxReviews, maxScore: $json.maxScore, sinceDate: $now.minus({ days: 1 }).toISODate() }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000004",
      "name": "Get new reviews",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build one Slack message from all new low-star reviews\nconst reviews = $input.all().map(i => i.json).filter(r => r.type === 'item');\nif (reviews.length === 0) {\n  return [{ json: { count: 0, text: 'No new low-star Google Play reviews since yesterday.' } }];\n}\nconst stars = n => { const s = Math.max(0, Math.min(5, Number(n) || 0)); return '★'.repeat(s) + '☆'.repeat(5 - s); };\nconst lines = reviews.slice(0, 30).map(r => {\n  const body = (r.text || '').replace(/\\s+/g, ' ').slice(0, 300);\n  const ver = r.version ? ` (v${r.version})` : '';\n  return `*${r.appName || r.appId}* ${stars(r.score)}${ver}\\n>${body}\\n<${r.url || r.appUrl}|Open in Google Play>`;\n});\nconst more = reviews.length > 30 ? `\\n_...and ${reviews.length - 30} more_` : '';\nreturn [{ json: { count: reviews.length, text: `*${reviews.length} new low-star Google Play reviews*\\n\\n` + lines.join('\\n\\n') + more } }];"
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000005",
      "name": "Build digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "f1",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000006",
      "name": "Any new reviews?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1140,
        0
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "text": "={{ $json.text }}",
        "otherOptions": {}
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000007",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        1360,
        -20
      ],
      "webhookId": "a1b2c3d4-0000-4000-8000-0000000000aa"
    }
  ],
  "connections": {
    "Every morning": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Get new reviews",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get new reviews": {
      "main": [
        [
          {
            "node": "Build digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build digest": {
      "main": [
        [
          {
            "node": "Any new reviews?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any new reviews?": {
      "main": [
        [
          {
            "node": "Post to Slack",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}